# Talí · Ecosistema Digital Scout — variables de entorno para docker compose.
#
# DESARROLLO: este archivo es OPCIONAL. Sin .env, docker compose usa valores de desarrollo.
# PRODUCCIÓN: copia este archivo como .env y reemplaza TODOS los valores "cambiar_esto".
#             El archivo .env nunca se sube a GitHub (está en .gitignore).

# ----- Base de datos (PostgreSQL) -----
POSTGRES_DB=ecosistema_scout
POSTGRES_USER=scout
POSTGRES_PASSWORD=cambiar_esto

# ----- API -----
# Production en servidores; Development solo en tu PC.
ASPNETCORE_ENVIRONMENT=Production
# Clave para firmar los tokens de inicio de sesión: mínimo 32 caracteres aleatorios.
JWT_CLAVE=cambiar_esto_por_una_clave_aleatoria_de_32_caracteres_o_mas

# ----- Usuarios de demostración -----
# Solo para desarrollo o demos. En producción debe ser false.
SEED_USUARIOS_DEMO=false
SEED_PASSWORD_DEMO=
